# Required for a NEW database. Use a long random URL-safe password.
# For example, generate one locally with: openssl rand -hex 24
# Do not change this to rotate an existing PostgreSQL password; that needs SQL.
POSTGRES_PASSWORD=

# Optional: empty permits unrestricted real-time access.
# A configured key gates real-time data, not access to the entire website.
LIVE_ACCESS_KEY=

# Optional: full image reference. Default ghcr.io/k0iry/cvd-core:latest;
# e.g. ghcr.io/k0iry/cvd-core:sha-<full commit> to pin a version.
CVD_IMAGE=
